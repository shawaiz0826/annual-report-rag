# Copy to .env and fill in. `.env` is gitignored.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Primary model used by the agent, profiler and extractor.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Secondary model, used by `make eval` for the comparison report and by `/model`.
LLM_MODEL_FALLBACK=google/gemma-4-31b-it:free
# Optional cheap model for local iteration; never used for eval reports or the demo.
LLM_MODEL_DEV=

# Optional: OpenRouter attribution headers
LLM_HTTP_REFERER=https://github.com/shawaiz0826/annual-report-rag
LLM_APP_TITLE=annual-report-rag

# Logging
LOG_LEVEL=INFO
